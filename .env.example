# --- Supabase (project: hneutwmmqvhtsijentee) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://hneutwmmqvhtsijentee.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Dashboard → Settings → API → anon/publishable key
SUPABASE_SERVICE_ROLE_KEY=                # server-only; NEVER exposed client-side
DATABASE_URL=                             # postgres://... for scripts/migrate.ts

# --- Data providers ----------------------------------------------------------
# Crypto market data (Coinbase/Kraken/CoinGecko) and prediction markets
# (Kalshi/Polymarket) work KEYLESS — no configuration required.
COINGECKO_API_KEY=                        # optional, raises rate limits
FOOTBALL_DATA_API_KEY=                    # free at football-data.org — unlocks live sports
FRED_API_KEY=                             # free — macro series (future phase)
VIXERA_ENABLE_BINANCE=false               # Binance returns HTTP 451 from US-hosted infra

# --- Demo data gate ----------------------------------------------------------
# Demo providers exist ONLY for keyless UI development. They are refused in
# production builds, and any prediction touching them is stamped dataMode:'demo'
# and excluded from all accuracy statistics.
VIXERA_ALLOW_DEMO=false
